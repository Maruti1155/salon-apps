generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}


model User {

  id        Int      @id @default(autoincrement())

  firstName String

  lastName  String

  email     String   @unique

  password  String

  role      Role     @default(SUPER_ADMIN)

  createdAt DateTime @default(now())

}


model Customer {

  id        Int      @id @default(autoincrement())

  name      String

  phone     String

  email     String?

  address   String?

  createdAt DateTime @default(now())


  appointments Appointment[]

}


model Service {

  id          Int      @id @default(autoincrement())

  name        String

  description String?

  price       Float

  createdAt   DateTime @default(now())


  appointments Appointment[]

}



model Appointment {
  id Int @id @default(autoincrement())

  customerId Int
  serviceId Int

  appointmentDate DateTime
  status AppointmentStatus @default(PENDING)
  amount Float

  customer Customer @relation(fields: [customerId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
}



enum Role {

  SUPER_ADMIN

  ADMIN

  STAFF

}



enum AppointmentStatus {

  PENDING

  CONFIRMED

  COMPLETED

  CANCELLED

}