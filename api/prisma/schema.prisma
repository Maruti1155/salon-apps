generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}


model User {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  role           Role     @default(SUPER_ADMIN)
  organizationId Int?
  parentId       Int?
  createdAt      DateTime @default(now())

  organization Organization? @relation("OrganizationUsers", fields: [organizationId], references: [id])
  parent       User?         @relation("UserHierarchy", fields: [parentId], references: [id])
  children     User[]        @relation("UserHierarchy")

  customers    Customer[]    @relation("CustomerCreatedBy")
  notifications Notification[]
  sentMessages  ChatMessage[]  @relation("ChatSender")
  receivedMessages ChatMessage[] @relation("ChatReceiver")
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  users      User[]   @relation("OrganizationUsers")
  customers  Customer[]
  services   Service[]
  appointments Appointment[]
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String
  email          String?
  address        String?
  organizationId Int?
  createdById    Int?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  appointments Appointment[]
}


model Service {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  duration       Int
  price          Float
  isActive       Boolean  @default(true)
  organizationId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  appointments Appointment[]
}



model Appointment {
  id Int @id @default(autoincrement())

  customerId Int
  serviceId Int
  organizationId Int?

  appointmentDate DateTime
  status AppointmentStatus @default(PENDING)
  amount Float

  customer Customer @relation(fields: [customerId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  text       String
  createdAt  DateTime @default(now())

  sender    User @relation("ChatSender", fields: [senderId], references: [id])
  receiver  User @relation("ChatReceiver", fields: [receiverId], references: [id])
}



enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}



enum AppointmentStatus {

  PENDING

  CONFIRMED

  COMPLETED

  CANCELLED

}